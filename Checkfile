# -trimpath and -buildvcs=false keep a test binary a function of its
# source alone. Without them a runner's slot path and the commit stamp
# are built in, so a result cached by one slot never counts for
# another and every run starts cold.
test: go test -trimpath -buildvcs=false -race -cover ./...

# goimports rather than gofmt, as in every other repo here: one command
# to remember, and it groups this module's own imports apart. -l lists
# what it would rewrite, and a non-empty list is the failure, since a
# CI job that rewrote source would have nowhere to put it.
# tools.mod pins goimports, not go.mod: a tool line in go.mod would put
# x/tools in the module graph of every module that requires this one.
# The runner installs no goimports, so this is also how CI gets one.
# go tool writes its download lines to stderr, which out= does not
# read.
lint: out=$(go tool -modfile=tools.mod goimports -local "$(go list -m)" -l .); if [ -n "$out" ]; then echo "$out"; exit 1; fi; go vet ./...

# gopls at hint severity is what an editor underlines and nobody
# reading a diff sees. It exits 0 whether or not it found anything, so
# its output is the verdict: awk prints what it read, then fails if it
# read a line.
hints: git ls-files -z '*.go' | xargs -0 gopls check -severity=hint | awk '1; END { exit (NR > 0) }'

# deadcode -test roots at main and at the test binaries, so a function
# that neither the command nor a test calls is reported. It exits 0
# either way, so awk reads the verdict, as hints does.
# The first go tool builds deadcode and discards everything it prints,
# so the "go: downloading" lines of a cold module cache do not count.
deadcode: go tool -modfile=tools.mod deadcode -h >/dev/null 2>&1; go tool -modfile=tools.mod deadcode -test ./... 2>&1 | awk '1; END { exit (NR > 0) }'

# scripts/tag pushes the tag every app resolves against, and it runs
# only at a release. A quoting bug in it would be found by the release
# it breaks, so shellcheck reads it on every push instead.
shellcheck: git ls-files -z 'scripts/*' '*.sh' | xargs -0 shellcheck

# dprint wraps Markdown at 72, the same column the commits use, so a
# paragraph does not change shape when it moves between them. check
# rather than fmt, for the same reason goimports runs with -l.
fmt: dprint check

# govulncheck builds from tools.mod and then reads go.mod, so it scans
# the versions this module ships. It reads the live vulnerability
# database, so a new advisory fails this check without a commit.
weekly_govulncheck: go tool -modfile=tools.mod govulncheck ./...

# The title a change needs to merge, and the body rules that come
# with it. sockeye reads this from main at merge.
merge: ^[a-z][a-z0-9_/-]*(?:, ?[a-z][a-z0-9_/-]*)*: [a-z](?:.{2,62})?(?:[^.\s]|\.\.\.)$
